### crontab
# For more information see the manual pages of crontab(5) and cron(8)

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Rotate the job log just before Proxmox backup starts (first Saturday of month, Proxmox runs sat *-1.7 00:10)
5 0 * * 6 [ $(date +\%d) -le 7 ] && /usr/bin/truncate -s 0 /var/log/rclone-backup.log

# offsite backup to S3 (megaS4)
# Proxmox backup: first Saturday of the month at 00:10 (sat *-1.7 00:10)
# MySQL offload:  every Saturday at 06:00
# Upload speed: 20-40 Mbps; 22 GB worst case ~2.5h at 20 Mbps
# Jobs spaced 5h apart → 2.5h buffer per slot even at slowest speed
# Sat jobs guarded: [ date -le 7 ] = first Saturday only
# Mon jobs guarded: [ date 3-9 ]   = Monday after first Saturday only
20 7  * * 6 [ $(date +\%d) -le 7 ] && /bin/bash /usr/local/sbin/offsite_bckp.sh 101
20 12 * * 6 [ $(date +\%d) -le 7 ] && /bin/bash /usr/local/sbin/offsite_bckp.sh 102
20 17 * * 6 [ $(date +\%d) -le 7 ] && /bin/bash /usr/local/sbin/offsite_bckp.sh 103
20 22 * * 6 [ $(date +\%d) -le 7 ] && /bin/bash /usr/local/sbin/offsite_bckp.sh 104
20 3  * * 1 [ $(date +\%d) -ge 3 ] && [ $(date +\%d) -le 9 ] && /bin/bash /usr/local/sbin/offsite_bckp.sh 109
20 8  * * 1 [ $(date +\%d) -ge 3 ] && [ $(date +\%d) -le 9 ] && /bin/bash /usr/local/sbin/offsite_bckp.sh 111

# clear memory cache every 2 hours (10,12,14,16,18,etc), fixed with guard against ongoing offload of backup
0 */2 * * * pgrep -f offsite_bckp.sh >/dev/null || echo 1 > /proc/sys/vm/drop_caches

# periodic reboot
#45 0 * * 7 /sbin/shutdown -r now 

